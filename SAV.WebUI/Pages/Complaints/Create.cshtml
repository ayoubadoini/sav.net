@page
@model SAV.WebUI.Pages.Complaints.CreateModel
@using SAV.WebUI.Models
@{
    ViewData["Title"] = "Nouvelle Réclamation";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h4 fw-bold mb-4">📝 Créer une Nouvelle Réclamation</h2>

                    <form method="post">
                        <div class="mb-3">
                            <label for="Subject" class="form-label fw-500">Sujet</label>
                            <input type="text" class="form-control" id="Subject" name="Input.Subject" 
                                   placeholder="Entrez le sujet de la réclamation" required>
                        </div>

                        <div class="mb-3">
                            <label for="Description" class="form-label fw-500">Description</label>
                            <textarea class="form-control" id="Description" name="Input.Description" 
                                      rows="5" placeholder="Décrivez le problème en détail" required></textarea>
                        </div>

                        <div class="mb-3">
                            <label for="ClientId" class="form-label fw-500">Client</label>
                            <select class="form-select" id="ClientId" name="Input.ClientId" required>
                                <option selected disabled>-- Sélectionnez un client --</option>
                                @if (Model.Clients != null)
                                {
                                    @foreach (var client in Model.Clients)
                                    {
                                        <option value="@client.Id">@client.Name (@client.Email)</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> Créer Réclamation
                            </button>
                            <a href="/Complaints" class="btn btn-outline-secondary">Annuler</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .fw-500 { font-weight: 500; }
    .form-control:focus, .form-select:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    }
</style>
