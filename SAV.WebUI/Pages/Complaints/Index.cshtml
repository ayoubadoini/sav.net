@page
@model SAV.WebUI.Pages.Complaints.IndexModel
@using SAV.WebUI.Models
@{
    ViewData["Title"] = "Réclamations";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="h3 fw-bold text-dark">📋 Gestion des Réclamations</h1>
            <p class="text-muted">Liste de toutes les réclamations clients</p>
        </div>
        <div class="col-md-4 text-end">
            <a href="/Complaints/Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Nouvelle Réclamation
            </a>
        </div>
    </div>

    <!-- Complaints Table -->
    @if (Model.Complaints != null && Model.Complaints.Count > 0)
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="fw-bold text-dark">ID</th>
                            <th class="fw-bold text-dark">Sujet</th>
                            <th class="fw-bold text-dark">Client</th>
                            <th class="fw-bold text-dark">Statut</th>
                            <th class="fw-bold text-dark">Date</th>
                            <th class="fw-bold text-dark">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var complaint in Model.Complaints)
                        {
                            <tr>
                                <td class="text-muted">#@complaint.Id</td>
                                <td class="fw-500">@complaint.Subject</td>
                                <td>@complaint.ClientName</td>
                                <td>
                                    @{
                                        var statusColor = complaint.Status switch
                                        {
                                            "Pending" => "warning",
                                            "In Progress" => "info",
                                            "Resolved" => "success",
                                            "Closed" => "secondary",
                                            _ => "light"
                                        };
                                    }
                                    <span class="badge bg-@statusColor">@complaint.Status</span>
                                </td>
                                <td class="text-muted small">@complaint.CreatedDate.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <a href="/Complaints/Details/@complaint.Id" class="btn btn-sm btn-outline-primary">Voir</a>
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteComplaint(@complaint.Id)">Supprimer</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <i class="bi bi-info-circle"></i> Aucune réclamation trouvée. 
            <a href="/Complaints/Create" class="alert-link">Créer une nouvelle</a>
        </div>
    }
</div>

<script>
function deleteComplaint(id) {
    if (confirm('Êtes-vous sûr de vouloir supprimer cette réclamation ?')) {
        fetch(`/api/complaints/${id}`, { method: 'DELETE' })
            .then(r => r.ok ? location.reload() : alert('Erreur lors de la suppression'));
    }
}
</script>

<style>
    .fw-500 { font-weight: 500; }
    tr:hover { background-color: rgba(0,0,0,0.02); }
</style>
